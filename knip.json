{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["package.json", "tests/**/*.test.ts", "e2e/**/*.spec.ts"],
      "project": ["tests/**/*.ts", "e2e/**/*.ts"]
    },
    "backend": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "frontend": {
      "entry": ["src/main.ts", "src/**/*.test.ts", "src/api/generated/*.ts"],
      "project": ["src/**/*.{ts,vue}"]
    }
  },
  "ignore": [".devagent/cache/**", "frontend/src/lib/utils.ts"],
  "ignoreDependencies": [
    "@fontsource/anton",
    "@fontsource/bebas-neue",
    "@fontsource/inter",
    "shadcn-vue",
    "tailwindcss"
  ]
}
