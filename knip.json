{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["package.json", "tests/**/*.test.ts"],
      "project": ["tests/**/*.ts"]
    },
    "backend": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "frontend": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.{ts,vue}"]
    }
  },
  "ignore": ["frontend/src/lib/utils.ts"],
  "ignoreDependencies": [
    "@fontsource/anton",
    "@fontsource/bebas-neue",
    "@fontsource/inter",
    "class-variance-authority",
    "clsx",
    "lucide-vue-next",
    "reka-ui",
    "shadcn-vue",
    "tailwind-merge",
    "tailwindcss"
  ]
}
