#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT/scripts/.versions"
source "$ROOT/scripts/lib/docker-verification.sh"

WORKSPACE="$(verification_workspace_root)"

verification_reset
verification_workdir "$WORKSPACE"
verification_add_arg -v "$WORKSPACE:$WORKSPACE"
verification_add_cache bun-install /cache/bun BUN_INSTALL_CACHE_DIR
verification_add_cache bun-home /cache/bun-home HOME
verification_add_env CI=1

verification_run_container "$BUN_IMAGE" sh -c '
  set -euo pipefail
  bun install --frozen-lockfile
  bun run test
'

COMPOSE_PROJECT_NAME="kamado-e2e-$(verification_sanitize_name "${VERIFY_RUN_ID:-$$}")"
export COMPOSE_PROJECT_NAME
cleanup_e2e() {
  docker compose --profile e2e down --volumes --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup_e2e EXIT INT TERM
cleanup_e2e
docker compose --profile e2e up --abort-on-container-exit --exit-code-from e2e e2e
