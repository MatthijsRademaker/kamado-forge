{
  "openapi": "3.0.3",
  "info": {
    "title": "Kamado API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "schemas": {
      "SessionPlanStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "instructions": {
            "type": "string"
          }
        },
        "required": ["id", "title", "durationMinutes", "instructions"],
        "additionalProperties": false
      },
      "SessionPlanPhase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "technique": {
            "type": "string"
          },
          "transitionGuidance": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionPlanStep"
            }
          }
        },
        "required": ["id", "title", "technique", "transitionGuidance", "steps"],
        "additionalProperties": false
      },
      "PlannedDomeTarget": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "nullable": true,
            "minimum": 150,
            "maximum": 700
          },
          "unit": {
            "type": "string",
            "enum": ["F"]
          }
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "PlannedFoodTarget": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "nullable": true,
            "minimum": 32,
            "maximum": 212
          },
          "unit": {
            "type": "string",
            "enum": ["F"]
          }
        },
        "required": ["value", "unit"],
        "additionalProperties": false
      },
      "SessionPlan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "enum": [""]
              },
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            ]
          },
          "phases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionPlanPhase"
            }
          },
          "plannedDomeTarget": {
            "$ref": "#/components/schemas/PlannedDomeTarget"
          },
          "plannedFoodTarget": {
            "$ref": "#/components/schemas/PlannedFoodTarget"
          },
          "setup": {
            "type": "string"
          },
          "ventFireGuidance": {
            "type": "string"
          },
          "prepNotes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "date",
          "phases",
          "plannedDomeTarget",
          "plannedFoodTarget",
          "setup",
          "ventFireGuidance",
          "prepNotes"
        ],
        "additionalProperties": false
      },
      "DatabaseHealth": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      },
      "HealthDataV1": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [true]
          },
          "service": {
            "type": "string",
            "enum": ["api"]
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseHealth"
          }
        },
        "required": ["ok", "service", "database"],
        "additionalProperties": false
      },
      "HealthSuccessV1": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthDataV1"
          }
        },
        "required": ["data"],
        "additionalProperties": false
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["path", "code", "message"],
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "issues": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                }
              }
            },
            "required": ["code", "message", "issues"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check API health",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSuccessV1"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Route not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  }
}
