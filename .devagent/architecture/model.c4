model {
  learner = person 'Kamado learner' {
    description '''
      The single project owner using the SPA outdoors and at planning time.
    '''
  }

  llmProvider = externalSystem 'LLM provider' {
    description '''
      Planned external model provider used for context-aware coaching answers.
    '''
  }

  kamadoCoach = softwareSystem 'Kamado BBQ Coach' {
    description '''
      Single-user web application for planning kamado cooks, receiving live guidance,
      asking context-aware questions, and recording lessons learned.
    '''

    frontend = container 'Vue SPA' {
      description '''
        Vite-powered Vue 3 application with Vue Router history routes, a responsive
        ProductShell for Today, Live, Plan, Coach, Learn, and Logbook, and an isolated
        primitive showcase at `/showcase`. Plan, Today, and ID-addressed Live routes consume
        durable session state through a Pinia Colada domain layer backed by generated transport.
      '''

      appShell = component 'Application root' {
        description 'Top-level Vue bootstrap and RouterView mounted from `frontend/src/main.ts` and `frontend/src/App.vue`.'
      }

      router = component 'Vue Router' {
        description 'History-mode router with five primary product destinations, a nested Live route, a canonical root redirect to Today, and standalone `/showcase`.'
      }

      productShell = component 'ProductShell' {
        description 'Shared responsive layout with desktop and mobile navigation around route-owned durable feature state.'
      }

      sessionQueries = component 'Session domain layer' {
        description 'Pinia Colada queries, pessimistic mutations, stable parameterized keys, and centralized reconciliation over the generated client.'
      }

      showcase = component 'Primitive showcase' {
        description 'Standalone internal component gallery mounted directly at `/showcase`, outside ProductShell and product navigation.'
      }

      healthQueries = component 'Health domain query' {
        description 'Hand-authored Pinia Colada composable and stable query key under `frontend/src/api/`.'
      }

      generatedClient = component 'Generated API client' {
        description 'Hey API fetch transport and types generated from the executable backend OpenAPI artifact under `frontend/src/api/generated/`.'
      }

      today = component 'Today route' {
        description 'Active-first `/today` entry that distinguishes no-active from failure and explicitly activates a selected eligible draft.'
      }

      live = component 'Live cook route' {
        description 'ID-addressed `/live/:sessionId` guidance and read-only terminal detail with pessimistic transitions and durable step notes.'
      }

      planner = component 'Session planner' {
        description 'Durable `/plan` editor with a local ordered form buffer, explicit create/update, and server-confirmed reconciliation.'
      }

      coach = component 'Coach route' {
        description 'Shipped `/coach` orientation placeholder; context-aware chat behavior remains planned.'
      }

      learn = component 'Learn route' {
        description 'Shipped `/learn` orientation placeholder; the kamado learning library remains planned.'
      }

      logbook = component 'Logbook route' {
        description 'Shipped `/logbook` orientation placeholder; cook history and lessons behavior remain planned.'
      }
    }

    backend = container 'Bun API' {
      description '''
        Bun TypeScript HTTP API. Exposes contract-validated health, complete planning draft CRUD,
        eligible/active lookup, cooking-session activation, ID-addressed live detail, notes, and
        state-transition routes; initializes SQLite and owns the future LLM boundary.
      '''

      healthApi = component 'Health API' {
        description 'Contract-validated `/api/health` endpoint reporting status without exposing the SQLite path.'
      }

      sessionApi = component 'Cooking session API' {
        description 'Complete planning-draft CRUD joined to activation, eligible and active lookup, ID-addressed detail, current-step notes, and transactional commands. SQLite enforces one ACTIVE or PAUSED session.'
      }

      coachApi = component 'Coach API' {
        description 'Planned endpoint boundary for LLM-assisted questions with session and memory context.'
      }

      learningApi = component 'Learning API' {
        description 'Planned endpoints for curated kamado learning content and generated explanations.'
      }

      logbookApi = component 'Logbook API' {
        description 'Planned endpoints for cook logs, results, notes, and lessons learned.'
      }

      memoryService = component 'Memory service' {
        description 'Planned service that summarizes preferences, skill level, recurring issues, and useful lessons.'
      }
    }

    sqlite = database 'SQLite database' {
      description '''
        Local SQLite persistence configured by `DATABASE_PATH`. It contains migration history,
        `app_metadata`, historic migration records, normalized planning sessions with phases and
        steps, and transactional live-cook drafts, immutable snapshot steps, session cursor/status,
        transitions, visits, and notes. Future logs, learning content, and memory remain in the
        same personal store.
      '''
    }
  }

  learner -> kamadoCoach.frontend 'plans cooks, follows guidance, asks questions, and reviews logs'
  kamadoCoach.frontend -[sync]-> kamadoCoach.backend 'calls JSON API via `/api/*`'
  kamadoCoach.backend -[persist]-> kamadoCoach.sqlite 'stores application data'
  kamadoCoach.backend.coachApi -[llm]-> llmProvider 'requests context-aware coaching answers'

  kamadoCoach.frontend.appShell -> kamadoCoach.frontend.router 'hosts router-rendered layouts'
  kamadoCoach.frontend.router -> kamadoCoach.frontend.productShell 'renders product routes through shared chrome'
  kamadoCoach.frontend.router -> kamadoCoach.frontend.showcase 'renders standalone internal gallery'
  kamadoCoach.frontend.productShell -> kamadoCoach.frontend.today 'renders session lifecycle entry'
  kamadoCoach.frontend.productShell -> kamadoCoach.frontend.live 'renders outdoor cook guidance'
  kamadoCoach.frontend.productShell -> kamadoCoach.frontend.planner 'renders durable ordered editor'
  kamadoCoach.frontend.productShell -> kamadoCoach.frontend.coach 'navigates to static route placeholder'
  kamadoCoach.frontend.productShell -> kamadoCoach.frontend.learn 'navigates to static route placeholder'
  kamadoCoach.frontend.productShell -> kamadoCoach.frontend.logbook 'navigates to static route placeholder'

  kamadoCoach.frontend.healthQueries -> kamadoCoach.frontend.generatedClient 'uses generated health operation'
  kamadoCoach.frontend.generatedClient -> kamadoCoach.backend.healthApi 'calls relative `/api/health`'
  kamadoCoach.frontend.planner -> kamadoCoach.frontend.sessionQueries 'saves complete ordered drafts'
  kamadoCoach.frontend.today -> kamadoCoach.frontend.sessionQueries 'queries active and eligible sessions'
  kamadoCoach.frontend.live -> kamadoCoach.frontend.sessionQueries 'queries detail and submits pessimistic actions'
  kamadoCoach.frontend.sessionQueries -> kamadoCoach.frontend.generatedClient 'uses generated session operations and types'
  kamadoCoach.frontend.generatedClient -> kamadoCoach.backend.sessionApi 'calls relative durable session routes'
  kamadoCoach.frontend.coach -> kamadoCoach.backend.coachApi 'sends user question with visible context'
  kamadoCoach.frontend.learn -> kamadoCoach.backend.learningApi 'browses learning material'
  kamadoCoach.frontend.logbook -> kamadoCoach.backend.logbookApi 'reviews and edits cook history'

  kamadoCoach.backend.sessionApi -> kamadoCoach.backend.memoryService 'reads preferences and prior lessons'
  kamadoCoach.backend.coachApi -> kamadoCoach.backend.memoryService 'builds prompt context'
  kamadoCoach.backend.logbookApi -> kamadoCoach.backend.memoryService 'feeds new lessons after each cook'
}
