views {
  view system-context {
    title 'System context'
    description 'The kamado learner uses one personal SPA. Coach is delivered behind a backend-only provider boundary; a future external production provider is shown but no vendor is selected.'
    include learner
    include kamadoCoach
    include llmProvider
    include learner -> kamadoCoach.frontend
    autoLayout LeftRight
  }

  view containers of kamadoCoach {
    title 'Containers and ownership boundaries'
    description 'The product is a Vue SPA, Bun API, and local SQLite store. The API owns persistence and the server-only Coach provider boundary.'
    include *
    include learner -> kamadoCoach.frontend
    include kamadoCoach.frontend -> kamadoCoach.backend
    include kamadoCoach.backend -> kamadoCoach.sqlite
    autoLayout LeftRight
  }

  view frontend-map of kamadoCoach.frontend {
    title 'Frontend navigation map'
    description 'Vue Router sends five primary destinations plus ID-addressed Live through ProductShell and keeps `/showcase` standalone. Plan, Today, Live, and Coach use generated operations through Pinia Colada domain modules; Learn and Logbook remain orientation-only.'
    include *
    include -> kamadoCoach.frontend.*
    autoLayout TopBottom
  }

  view backend-map of kamadoCoach.backend {
    title 'Backend service map'
    description 'The Bun API keeps session endpoints separate from the delivered read-only coach orchestration and future learning, logbook, and memory boundaries.'
    include *
    include kamadoCoach.sqlite
    include kamadoCoach.backend.* -> kamadoCoach.sqlite
    include kamadoCoach.backend.* -> kamadoCoach.backend.*
    include kamadoCoach.backend.* -> kamadoCoach.backend.memoryService
    autoLayout LeftRight
  }

  dynamic view cook-session-loop {
    title 'Cook session product loop'
    description 'The strategic loop that future features should preserve: plan, cook, ask, log, and learn from memory.'
    learner -> kamadoCoach.frontend.planner 'plans a cooking day'
    kamadoCoach.frontend.planner -> kamadoCoach.backend.sessionApi 'saves plan and targets'
    learner -> kamadoCoach.frontend.today 'reviews or starts the current cook'
    learner -> kamadoCoach.frontend.live 'follows live outdoor guidance'
    kamadoCoach.frontend.live -> kamadoCoach.backend.sessionApi 'records progress, transitions, and current-step notes'
    learner -> kamadoCoach.frontend.coach 'opens context-aware Coach'
    kamadoCoach.frontend.coach -> kamadoCoach.frontend.sessionQueries 'loads displayed active-session context'
    kamadoCoach.frontend.sessionQueries -> kamadoCoach.frontend.generatedClient 'uses generated active-session operation'
    kamadoCoach.frontend.generatedClient -> kamadoCoach.backend.sessionApi 'reads the active session'
    learner -> kamadoCoach.frontend.coach 'asks context-aware question'
    kamadoCoach.frontend.coach -> kamadoCoach.frontend.coachMutation 'submits or retries the same local turn'
    kamadoCoach.frontend.coachMutation -> kamadoCoach.frontend.generatedClient 'uses generated Coach operation'
    kamadoCoach.frontend.generatedClient -> kamadoCoach.backend.coachApi 'sends one strict question'
    kamadoCoach.backend.coachApi -> kamadoCoach.backend.coachService 'delegates validated question'
    kamadoCoach.backend.coachService -> kamadoCoach.sqlite 'reads and allowlists active-session context'
    kamadoCoach.backend.coachService -> kamadoCoach.backend.coachProvider 'invokes configured fake or disabled provider'
    learner -> kamadoCoach.frontend.logbook 'logs outcome and lessons'
    kamadoCoach.frontend.logbook -> kamadoCoach.backend.logbookApi 'persists actuals and notes'
    kamadoCoach.backend.logbookApi -> kamadoCoach.backend.memoryService 'updates durable learning memory'
  }

  deployment view local-development {
    title 'Local development topology'
    description 'Current developer topology: Vite serves the SPA, proxies `/api` to Bun, and Bun opens a local SQLite file.'
    include localDev.**
    autoLayout LeftRight
  }
}
